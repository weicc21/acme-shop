{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@acme/pricing": [
        "packages/pricing/src/index.ts"
      ],
      "@acme/support": [
        "packages/support/src/assistant.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts"
  ]
}
